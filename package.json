{
  "name": "podcast-capture",
  "version": "0.3.0",
  "description": "Capture podcast episode links in a configurable Markdown log.",
  "author": "Ch1llNoodle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ch1llNoodle/obsidian-podcast-capture.git"
  },
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "node --test tests/core.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "license": "0-BSD",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
